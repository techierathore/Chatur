<?xml version="1.0" encoding="utf-8"?>
<!-- No credentials in this file (Coding Standards §Security). The GitHub Packages feed token lives
     in the machine's own NuGet settings (Architecture §6, 2026-09-21 decision row). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="TrBlazeUI" value="https://nuget.pkg.github.com/techierathore/index.json" />
  </packageSources>
</configuration>

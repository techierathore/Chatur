<?xml version="1.0" encoding="utf-8" ?>
<!-- The main window: menu bar, files, tabs, conversation, output (Architecture §6, 2026-09-22
     "the main window is where work happens"). -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ChaturUI="clr-namespace:ChaturUI;assembly=ChaturUI"
             x:Class="Chatur.Windows.MainWindowPage"
             AutomationId="chatur-main-page">

    <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html" AutomationId="chatur-main-webview">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type ChaturUI:ChaturRoutes}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>

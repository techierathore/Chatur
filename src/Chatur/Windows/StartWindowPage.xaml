<?xml version="1.0" encoding="utf-8" ?>
<!-- The start window: recent projects and the ways in (Architecture §6, 2026-09-22 "Three windows"). -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ChaturUI="clr-namespace:ChaturUI;assembly=ChaturUI"
             x:Class="Chatur.Windows.StartWindowPage"
             AutomationId="chatur-start-page">

    <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html" AutomationId="chatur-start-webview">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type ChaturUI:ChaturRoutes}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>

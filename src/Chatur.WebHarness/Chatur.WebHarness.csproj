<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Test only — never shipped to the owner (Architecture §2 "Chatur.WebHarness"). Hosts
         ChaturUI's screens in a browser so the headless browser checks can run on every build. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Chatur.WebHarness</RootNamespace>
    <AssemblyName>Chatur.WebHarness</AssemblyName>

    <!-- Same id as src/Chatur/Chatur.csproj (Foundation brief) — this harness reads the same
         AppManager:*/Chatur:TestUsers:* development secrets so a real sign-in (REQ-UI-001,
         REQ-UI-002) can be smoked against the local App Manager from the browser checks. -->
    <UserSecretsId>chatur-3f1c9a52-0d4e-4b7a-9c1e-5a8e2b7d6f10</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Chatur.Core\Chatur.Core.csproj" />
    <ProjectReference Include="..\ChaturUI\ChaturUI.csproj" />
    <ProjectReference Include="..\ChaturDb\ChaturDb.csproj" />
  </ItemGroup>

</Project>

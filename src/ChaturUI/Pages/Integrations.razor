@page "/integrations"
@layout Layouts.SecondaryLayout
@using TrBlazeUI.Components.Table
@inject IIntegrationActions IntegrationActions
@inject NavigationManager Navigation
@inject BrowserInterop Browser
@inject ToastService Toast

@* UI Design phase 4 "Screen: Integrations" — mockups/integrations.html. Cluster P4-E: the actions Chatur
   offers to outside tools and their addresses (REQ-FN-081), a process an outside tool started and the run
   listed (REQ-FN-082), the verifier's checks on real windows (REQ-FN-083) and the signed downloads of a
   release (REQ-UI-069). The "Started from outside" panel is not in the mockup: it is where the run an outside
   tool started is listed (decided in the P4 checklist). *@
<div class="flex flex-col gap-4" data-testid="integrations-page">
    <div class="flex flex-wrap items-center gap-3" data-testid="integrations-heading">
        <div>
            <h1 class="text-lg font-semibold">Chatur's actions, offered to other tools</h1>
            <p class="text-sm text-muted-foreground">@Lead</p>
        </div>
        <span class="grow"></span>
        <Button Class="rounded-full" Variant="ButtonVariant.Outline" OnClick="NewTokenAsync" data-testid="new-token">
            <LucideIcon Name="plus" Size="14" />
            New token
        </Button>
    </div>

    @if (objNewToken is not null)
    {
        <Alert Variant="AlertVariant.Info" data-testid="token-panel">
            <LucideIcon Name="key" Size="16" />
            <AlertTitle>Your new token — shown once</AlertTitle>
            <AlertDescription>
                <span class="font-mono text-xs break-all" data-testid="token-value">@objNewToken</span>
                <div class="mt-2">
                    <Button Class="rounded-full" Size="ButtonSize.Small" Variant="ButtonVariant.Outline" OnClick="CopyTokenAsync" data-testid="copy-token">Copy</Button>
                    <Button Class="rounded-full" Size="ButtonSize.Small" Variant="ButtonVariant.Ghost" OnClick="HideToken" data-testid="hide-token">I have copied it</Button>
                </div>
            </AlertDescription>
        </Alert>
    }

    <Card data-testid="actions-panel">
        <CardHeader>
            <CardTitle>
                <span class="inline-flex items-center gap-2"><LucideIcon Name="link" Size="16" />What Chatur offers</span>
            </CardTitle>
            <span class="text-xs text-muted-foreground" data-testid="actions-count">@OnCount of @(objActions?.Count ?? 0) on</span>
        </CardHeader>
        <CardContent Class="p-0">
            @if (objActions is null)
            {
                <Empty Title="Reading the actions" Description="Chatur is listing what it offers." Size="EmptySize.Small" data-testid="actions-empty" />
            }
            else
            {
                <Table Class="min-w-4xl" data-testid="actions-table">
                    <TableHeader>
                        <TableRow>
                            <TableHead Class="h-auto px-3.5 py-2.5 text-xs font-medium text-muted-foreground">Action</TableHead>
                            <TableHead Class="h-auto px-3.5 py-2.5 text-xs font-medium text-muted-foreground">What it does</TableHead>
                            <TableHead Class="h-auto px-3.5 py-2.5 text-xs font-medium text-muted-foreground">What starts it</TableHead>
                            <TableHead Class="h-auto px-3.5 py-2.5 text-xs font-medium text-muted-foreground">Address</TableHead>
                            <TableHead Class="h-auto px-3.5 py-2.5 text-xs font-medium text-muted-foreground">State</TableHead>
                            <TableHead Class="h-auto px-3.5 py-2.5 text-xs font-medium text-muted-foreground"></TableHead>
                        </TableRow>
                    </TableHeader>
                    <TableBody>
                        @foreach (var vAction in objActions)
                        {
                            <TableRow Class="border-t border-b-0" data-testid="@($"action-row-{vAction.Code}")">
                                <TableCell Class="px-3.5 py-2.5 text-xs font-medium">@vAction.Name</TableCell>
                                <TableCell Class="px-3.5 py-2.5 text-xs text-muted-foreground">@vAction.Does</TableCell>
                                <TableCell Class="px-3.5 py-2.5 text-xs text-muted-foreground">@vAction.StartedBy</TableCell>
                                <TableCell Class="px-3.5 py-2.5 font-mono text-xs whitespace-nowrap">@vAction.Address</TableCell>
                                <TableCell Class="px-3.5 py-2.5">
                                    <Badge Variant="@(vAction.Enabled ? BadgeVariant.Success : BadgeVariant.Secondary)" Class="h-5 border-0 border-none px-2.5 text-xs whitespace-nowrap" data-testid="@($"action-state-{vAction.Code}")">@StateText(vAction)</Badge>
                                </TableCell>
                                <TableCell Class="px-3.5 py-2.5">
                                    <Switch Size="SwitchSize.Small" Checked="@vAction.Enabled" Disabled="@(!vAction.Built)"
                                            AriaLabel="@($"{vAction.Name} — {(vAction.Enabled ? "on" : "off")}")"
                                            CheckedChanged="@((bool aOn) => SetAsync(vAction, aOn))"
                                            data-testid="@($"action-switch-{vAction.Code}")" />
                                </TableCell>
                            </TableRow>
                        }
                    </TableBody>
                </Table>
            }
        </CardContent>
    </Card>

    <Card data-testid="example-call">
        <CardHeader Class="flex flex-row items-center justify-between gap-2">
            <CardTitle>One call, and what it gives back</CardTitle>
            @* The mockup's own copy button (copy-example); the code block's built-in one has no test label. *@
            <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSmall" AriaLabel="Copy the call and its answer" OnClick="CopyExampleAsync" data-testid="copy-example">
                <LucideIcon Name="copy" Size="14" />
            </Button>
        </CardHeader>
        <CardContent>
            <CodeBlock Code="@ExampleCall" ShowCopyButton="false" data-testid="example-pre" />
            <p class="mt-2 text-xs text-muted-foreground">The token is made here with New token and is shown once. An action that is off answers 404, as though it were never there.</p>
        </CardContent>
    </Card>

    <Card data-testid="outside-runs">
        <CardHeader>
            <CardTitle>Started from outside</CardTitle>
        </CardHeader>
        <CardContent Class="p-0">
            @if (objOutsideRuns is null or { Count: 0 })
            {
                <Empty Title="Nothing started from outside yet" Description="A process an outside tool starts is listed here with its run number." Size="EmptySize.Small" data-testid="outside-runs-empty" />
            }
            else
            {
                <Table data-testid="outside-runs-table">
                    <TableHeader>
                        <TableRow><TableHead Class="h-auto px-3.5 py-2.5 text-xs font-medium text-muted-foreground">Run</TableHead><TableHead Class="h-auto px-3.5 py-2.5 text-xs font-medium text-muted-foreground">Process</TableHead><TableHead Class="h-auto px-3.5 py-2.5 text-xs font-medium text-muted-foreground">Project</TableHead><TableHead Class="h-auto px-3.5 py-2.5 text-xs font-medium text-muted-foreground">When</TableHead></TableRow>
                    </TableHeader>
                    <TableBody>
                        @foreach (var vRun in objOutsideRuns)
                        {
                            <TableRow Class="border-t border-b-0" data-testid="@($"outside-run-{vRun.RunId}")">
                                <TableCell Class="px-3.5 py-2.5 font-mono">@vRun.RunId</TableCell>
                                <TableCell Class="px-3.5 py-2.5">@vRun.ProcessCode</TableCell>
                                <TableCell Class="px-3.5 py-2.5">@vRun.ProjectName</TableCell>
                                <TableCell Class="px-3.5 py-2.5 text-muted-foreground whitespace-nowrap">@When(vRun.CalledUtc)</TableCell>
                            </TableRow>
                        }
                    </TableBody>
                </Table>
            }
        </CardContent>
    </Card>

    <Card data-testid="verifier-windows">
        <CardHeader>
            <CardTitle>
                <span class="inline-flex items-center gap-2"><LucideIcon Name="monitor" Size="16" />The verifier on real windows</span>
            </CardTitle>
        </CardHeader>
        <div class="px-4 pb-3" data-testid="verifier-intro">
            <p class="flex items-start gap-2 text-xs text-muted-foreground" data-testid="verifier-line">
                <LucideIcon Name="check" Size="16" Class="mt-0.5 shrink-0" />
                <span>It drives the windows of the Mac and Windows applications Chatur built — it presses the real buttons in the real window, on the machine that built it, and keeps a screenshot of each screen it saw.</span>
            </p>
        </div>
        <CardContent Class="p-0">
            @if (objChecks is null or { Count: 0 })
            {
                <Empty Title="No window checked yet" Description="When the verifier drives a built Mac or Windows application, the check is listed here with its screenshots." Size="EmptySize.Small" data-testid="checks-empty" />
            }
            else
            {
                <Table Class="min-w-xl" data-testid="checks-table">
                    <TableHeader>
                        <TableRow>
                            <TableHead Class="h-auto px-3.5 py-2.5 text-xs font-medium text-muted-foreground">Application</TableHead>
                            <TableHead Class="h-auto px-3.5 py-2.5 text-xs font-medium text-muted-foreground">Machine</TableHead>
                            <TableHead Class="h-auto px-3.5 py-2.5 text-xs font-medium text-muted-foreground">Screenshots kept</TableHead>
                            <TableHead Class="h-auto px-3.5 py-2.5 text-xs font-medium text-muted-foreground">When</TableHead>
                            <TableHead Class="h-auto px-3.5 py-2.5 text-xs font-medium text-muted-foreground">Result</TableHead>
                        </TableRow>
                    </TableHeader>
                    <TableBody>
                        @for (var vIndex = 0; vIndex < objChecks.Count; vIndex++)
                        {
                            var vCheck = objChecks[vIndex];
                            var vNumber = vIndex + 1;
                            <TableRow Class="border-t border-b-0" data-testid="@($"check-row-{vNumber}")">
                                <TableCell Class="px-3.5 py-2.5 whitespace-nowrap">@vCheck.Application</TableCell>
                                <TableCell Class="px-3.5 py-2.5 text-muted-foreground whitespace-nowrap">@vCheck.Machine</TableCell>
                                <TableCell Class="px-3.5 py-2.5">@vCheck.ScreenshotsKept</TableCell>
                                <TableCell Class="px-3.5 py-2.5 text-muted-foreground whitespace-nowrap">@When(vCheck.CheckedUtc)</TableCell>
                                <TableCell Class="px-3.5 py-2.5">
                                    <Badge Variant="@(vCheck.Passed ? BadgeVariant.Success : BadgeVariant.Warning)" Class="h-5 border-0 border-none px-2.5 text-xs whitespace-nowrap" data-testid="@($"check-state-{vNumber}")">@if (vCheck.Passed){<LucideIcon Name="check" Size="11" />}@vCheck.Result</Badge>
                                </TableCell>
                            </TableRow>
                        }
                    </TableBody>
                </Table>
            }
        </CardContent>
    </Card>

    <Card data-testid="downloads-panel">
        <CardHeader>
            <CardTitle>
                <span class="inline-flex items-center gap-2"><LucideIcon Name="shield-check" Size="16" />Signed downloads</span>
            </CardTitle>
        </CardHeader>
        <CardContent>
            @if (objDownloads is null or { Count: 0 })
            {
                <Empty Title="No release published yet" Description="When a release is published, its Mac and Windows downloads are listed here with who signed them." Size="EmptySize.Small" data-testid="downloads-empty" />
            }
            else
            {
                @foreach (var vDownload in objDownloads)
                {
                    var vKey = vDownload.Platform == "Mac" ? "mac" : "win";
                    <div class="flex flex-wrap items-center gap-3 border-t py-2.5" data-testid="@($"download-{vKey}")">
                        <LucideIcon Name="download" Size="16" Class="text-muted-foreground" />
                        <div class="min-w-48 grow">
                            <div class="text-sm font-medium">Chatur @vDownload.Version · @vDownload.Platform <span class="font-mono text-xs text-muted-foreground">@vDownload.FileName</span></div>
                            <div class="text-xs text-muted-foreground">Signed by @vDownload.SignedBy</div>
                        </div>
                        <Badge Variant="@(vDownload.Notarisation == NotarisationState.Notarised ? BadgeVariant.Success : BadgeVariant.Secondary)" Class="h-5 border-0 border-none px-2.5 text-xs whitespace-nowrap" data-testid="@($"download-{vKey}-notarised")">@if (vDownload.Notarisation == NotarisationState.Notarised){<LucideIcon Name="check" Size="11" />}@NotarisationText(vDownload.Notarisation)</Badge>
                        <span class="text-xs text-muted-foreground" data-testid="@($"download-{vKey}-when")">@When(vDownload.PublishedUtc)</span>
                    </div>
                }
                <p class="pt-2 text-xs text-muted-foreground">Notarising is an Apple step, so it applies to the Mac download only. A download is listed only when it says who signed it.</p>
            }
        </CardContent>
    </Card>
</div>

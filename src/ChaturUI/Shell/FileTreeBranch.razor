@* Recursive helper for FilesPanel (REQ-UI-039): one level of the tree. A folder's own rows are read
   the first time it opens (TreeItem HasChildren + OnExpand, BRD-217), and a folder Chatur cannot read
   is shown with a lock and "not readable", and never opens. A runnable project's row offers "Set as the
   project to run" on a right-click (BRD-228). Not a page of its own: never routed, never listed. *@
@foreach (var vNode in Nodes)
{
    var vPath = vNode.RelativePath;
    var vTarget = Panel?.RunTargetFor(vNode);
    @if (vNode.IsFolder && !vNode.IsReadable)
    {
        <TreeItem Label="@vNode.Name" Value="@vPath" Disabled="true" data-testid="@($"tree-{vPath}")" data-readable="false">
            <Icon><LucideIcon Name="folder-lock" Size="16" /></Icon>
            <LabelContent><span>@vNode.Name</span> <span class="text-xs text-muted-foreground" data-testid="@($"tree-{vPath}-unreadable")">not readable</span></LabelContent>
        </TreeItem>
    }
    else if (vNode.IsFolder)
    {
        <TreeItem Label="@vNode.Name" LabelContent="@(vTarget is null ? null : RunLabel(vNode, vTarget))" Value="@vPath" HasChildren="true" OnExpand="@(() => Panel!.LoadChildrenAsync(vPath))" Loading="@(Panel?.IsLoading(vPath) ?? false)"
                  Expanded="@objOpen.Contains(vPath)" ExpandedChanged="@(vOpen => SetOpen(vPath, vOpen))" data-testid="@($"tree-{vPath}")">
            <Icon><LucideIcon Name="@(objOpen.Contains(vPath) ? "folder-open" : "folder")" Size="16" /></Icon>
            <ChildContent>
                <FileTreeBranch Nodes="@(Panel?.ChildrenOf(vPath) ?? [])" />
            </ChildContent>
        </TreeItem>
    }
    else
    {
        <TreeItem Label="@vNode.Name" LabelContent="@(vTarget is null ? null : RunLabel(vNode, vTarget))" Value="@vPath" data-testid="@($"tree-{vPath}")">
            <Icon><LucideIcon Name="file" Size="16" /></Icon>
        </TreeItem>
    }
}


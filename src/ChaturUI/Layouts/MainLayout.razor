@inherits LayoutComponentBase

@* [fix 2026-09-23] docs/Chatur-UIDesign.md "Rules": below 1100 the file view and the conversation
   stack; below 980 the toolbar drops what only reports; below 820 the files panel goes. These mirror
   mockups/chatur.css's own breakpoints exactly (no colour literals — layout only), targeted by
   data-testid so they reach the child components' own markup regardless of which owns the element. *@
<style>
    @@media (max-width: 1100px) {
        .workbench-split {
            flex-direction: column;
            align-self: flex-start;
            overflow: visible !important;
        }

        /* Stacked, the panels can no longer share the window's height: each keeps a usable minimum and
           the window grows with them, so the page scrolls as the mockup's does (the chat's own thread
           still scrolls inside it). */
        [data-testid="window"] {
            height: auto !important;
            min-height: 100vh;
        }

        .workbench-body {
            flex: none !important;
            overflow: visible !important;
        }

        [data-testid="chat-panel"] {
            min-height: 28rem;
        }

        [data-testid="files-area"] {
            min-height: 12rem;
        }
    }

    @@media (max-width: 980px) {
        [data-testid="wordmark"],
        [data-testid="account-name"] {
            display: none;
        }

        [data-testid="toolbar-reporting"],
        [data-testid="build"],
        [data-testid="target"] {
            display: none;
        }
    }

    /* Phone width: the menu bar must fit without the page scrolling sideways (the mockup's "never
       clip the menu bar"), so the project name and the logo give way and the menus tighten. */
    @@media (max-width: 600px) {
        /* the switcher keeps its folder icon and still opens the project list */
        [data-testid="project-switch-name"],
        [data-testid="logo"] {
            display: none;
        }

        [data-testid="menu-file"], [data-testid="menu-edit"], [data-testid="menu-view"],
        [data-testid="menu-project"], [data-testid="menu-tools"], [data-testid="menu-help"] {
            padding-left: 2px;
            padding-right: 2px;
        }

        [data-testid="menubar"] {
            gap: 0;
            padding-left: 4px;
            padding-right: 4px;
        }
    }

    @@media (max-width: 820px) {
        [data-testid="files-panel"],
        [data-testid="files-head"],
        [data-testid="file-tree"],
        [data-testid="branch"] {
            display: none;
        }
    }
</style>

<div class="flex h-screen flex-col bg-background" data-testid="window">
    <MenuBar />
    <AppToolbar />
    <AuthGate>
        @* [fix 2026-10-02, REQ-UI-010..041 parity] Same shape as mockups/main.html's window: menubar,
           toolbar, an unanchored body row (files panel + split), then the output strip as the
           window's own last child. The body carries no data-testid because the mockup's does not;
           an anchor on only one side keys the same box twice and reads as a missing element. *@
        <div class="workbench-body flex min-h-0 flex-1 gap-2 overflow-hidden p-2">
            @Body
        </div>
        <OutputStrip />
    </AuthGate>
</div>

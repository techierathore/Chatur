@inherits LayoutComponentBase
@implements IDisposable

<div class="flex h-screen flex-col bg-background" data-testid="window">
    <div class="flex h-9 flex-none items-center gap-2 border-b bg-card px-3" data-testid="menubar">
        <span class="flex h-5 w-5 items-center justify-center rounded bg-primary text-xs font-bold text-primary-foreground" data-testid="logo">C</span>
        <span class="text-sm font-semibold" data-testid="wordmark">Chatur</span>
        <div class="ml-auto flex items-center gap-2" data-testid="window-tools">
            <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSmall" AriaLabel="Light or dark" OnClick="ToggleDarkModeAsync" data-testid="theme-toggle">
                <LucideIcon Name="@(AppState.IsDark ? "moon" : "sun")" Size="16" />
            </Button>
            <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="CyclePaletteAsync" data-testid="palette">
                @ThemeDisplayName
            </Button>
        </div>
    </div>
    <div class="flex min-h-0 flex-1 items-center justify-center overflow-auto p-2">
        @Body
    </div>
</div>

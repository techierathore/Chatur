@inherits LayoutComponentBase

<div class="flex min-h-screen flex-col bg-background sm:h-screen" data-testid="start-window">
    <div class="flex h-11 flex-none items-center gap-2 border-b bg-card px-4" data-testid="startbar">
        <span class="flex h-5 w-5 items-center justify-center rounded bg-primary text-xs font-bold text-primary-foreground" data-testid="logo">C</span>
        <span class="text-sm font-semibold" data-testid="wordmark">Chatur</span>
        <span class="flex-1"></span>
        @* UI Design "Screen: Start", region `startbar`: the wordmark, the signed-in user, light or dark. *@
        <AccountMenu />
        <ThemeToggle />
    </div>
    <AuthGate>
        @* [fix 2026-09-23] `recent-side` (flex-1) and `get-started` (a fixed w-96) sat in a row that
           never stacked, so below 640px `get-started` held its own 384px and squeezed `recent-side`
           down to a sliver — every word in it wrapped to its own line (UIDesign "Rules": a panel
           scrolls inside itself, no window scrolls sideways). Stacked below 640px instead.
           [fix 2026-10-02] Below 640px the window itself grows and scrolls (min-h-screen), so no box in
           it is cut off against the mockup; from 640px up each panel scrolls inside itself. *@
        <div class="flex flex-1 flex-col sm:min-h-0 sm:flex-row sm:overflow-hidden">
            @Body
        </div>
    </AuthGate>
</div>
